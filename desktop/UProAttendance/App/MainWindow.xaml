<Window x:Class="UProAttendance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UProAttendance.Presentation"
        Title="UPro Attendance" Width="1180" Height="704" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#FFFFFF" FontFamily="Segoe UI"
        FontSize="14" Foreground="#171716" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#171716"/>
        <SolidColorBrush x:Key="Muted" Color="#615F5B"/>
        <SolidColorBrush x:Key="Line" Color="#E7E4DF"/>
        <SolidColorBrush x:Key="Surface" Color="#F8F7F4"/>
        <LinearGradientBrush x:Key="ScannerSurface" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FBFAF8"/>
            <GradientStop Offset="1" Color="#F3F0EA"/>
        </LinearGradientBrush>
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="MinHeight" Value="43"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#85817A"/>
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.70"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#76674E"/>
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F4F3F0"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#EBE9E4"/>
                                <Setter Property="Foreground" Value="#74716C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}"/>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="AdminCard" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Padding" Value="22,22"/>
            <Setter Property="MinHeight" Value="126"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="FormCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="MaxWidth" Value="550"/>
            <Setter Property="MinWidth" Value="410"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="43"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="40" Height="23" Margin="0,0,9,0">
                                <Border x:Name="Track" CornerRadius="12" Background="#DCD9D3"/>
                                <Ellipse x:Name="Thumb" Width="17" Height="17" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0" VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Ink}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="HeaderRow" Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="34,0" MaxWidth="1080" LastChildFill="False">
                <Image DockPanel.Dock="Left" Source="Assets/logo.png" Width="155" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="U Professional Hairstudio"/>
                <Button x:Name="NavButton" DockPanel.Dock="Right" VerticalAlignment="Center" MinHeight="38"
                        Content="Administración  →" Click="Navigate"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="ContentRoot" Margin="34,25,34,24" MaxWidth="1080" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PageIntro" Margin="0,0,0,24">
                    <TextBlock x:Name="TitleText" Text="Registro de asistencia" Style="{StaticResource Heading}"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock x:Name="Subtitle" Text="Coloca tu dedo para registrar el siguiente movimiento."
                               Style="{StaticResource Caption}" FontSize="15" Margin="1,7,0,0"/>
                </StackPanel>

                <Grid x:Name="ScanPanel" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.32*"/>
                        <ColumnDefinition x:Name="ScannerGap" Width="20"/>
                        <ColumnDefinition x:Name="ScannerAside" Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ScannerCard" BorderBrush="{StaticResource Line}" CornerRadius="20" BorderThickness="1"
                            Padding="18,23,18,22" MinHeight="375" Background="{StaticResource ScannerSurface}">
                        <StackPanel VerticalAlignment="Center">
                            <Viewbox x:Name="ScannerVisual" Height="198" Margin="0,0,0,19" HorizontalAlignment="Center">
                                <Grid Width="218" Height="198">
                                    <Border Width="148" Height="148" CornerRadius="74" Background="#FCFBF9"
                                            BorderBrush="#E8E3DA" BorderThickness="1"/>
                                    <Path Stroke="#A19A8C" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 40,42 L 40,24 L 59,24 M 159,24 L 178,24 L 178,42 M 40,156 L 40,174 L 59,174 M 159,174 L 178,174 L 178,156"/>
                                    <ui:FingerprintArt x:Name="Fingerprint" Width="125" Height="125"
                                                       IsHitTestVisible="False" Focusable="False"/>
                                </Grid>
                            </Viewbox>
                            <TextBlock x:Name="ConfirmationLabel" Visibility="Collapsed" Foreground="#376849"
                                       TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="Prompt" Text="Coloca tu dedo en el lector" TextAlignment="Center"
                                       TextWrapping="Wrap" FontSize="24" FontWeight="SemiBold" MaxWidth="680"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="ScanDetail" Text="Comprobando el estado del lector…" TextAlignment="Center"
                                       Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="520" AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,17,0,0" HorizontalAlignment="Center">
                                <ProgressBar x:Name="SampleBar" Width="150" Minimum="0" Maximum="3" Height="4"
                                             Background="#E4E0D8" Foreground="#222120" BorderThickness="0"
                                             AutomationProperties.Name="Progreso de muestras aceptadas"/>
                                <TextBlock x:Name="SampleCount" TextAlignment="Center" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="CaptureAside" Grid.Column="2" BorderBrush="{StaticResource Line}" CornerRadius="20" BorderThickness="1"
                            Background="White" Padding="23,21">
                        <Grid>
                            <StackPanel x:Name="CaptureSummary" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock x:Name="CaptureEmployee" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="CaptureFinger" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                                <Button x:Name="CaptureBackButton" Content="Cancelar captura" Click="Navigate"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <ui:AttendanceConfirmation x:Name="AttendanceReceipt" Grid.Row="1" MaxWidth="1000"
                                           Visibility="Collapsed"/>
                <Grid Grid.Row="1">
                    <StackPanel x:Name="AdminHomePanel" Visibility="Collapsed">
                        <UniformGrid Columns="2">
                            <Button x:Name="SettingsButton" Style="{StaticResource AdminCard}" Click="OpenSettings"
                                    AutomationProperties.Name="Configuración" Margin="0,0,9,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="›" FontSize="26" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Configuración" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Ajusta el descanso de la jornada." Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <Button x:Name="EmployeesButton" Style="{StaticResource AdminCard}" Click="OpenEmployees"
                                    AutomationProperties.Name="Alta de empleado" Margin="9,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="›" FontSize="26" Foreground="{StaticResource Muted}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <StackPanel>
                                        <TextBlock Text="Alta de empleado" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="Registra huellas de una estilista de UProApp."
                                                   Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock x:Name="AdminHomeStatus" Style="{StaticResource Caption}" Margin="0,10,0,0"
                                   Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <Border x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource FormCard}">
                        <StackPanel>
                            <TextBlock Text="Jornada de hoy" FontSize="21" FontWeight="SemiBold"/>
                            <CheckBox x:Name="BreakToggle" Content="Hay descanso hoy" Click="ChangeBreak"
                                      Style="{StaticResource Switch}" Margin="0,12,0,0"/>
                            <TextBlock x:Name="BreakDescription" Text="Solo entrada y salida."
                                       Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="EnrollForm" Visibility="Collapsed" Style="{StaticResource FormCard}">
                        <StackPanel>
                            <Label Content="Estilista" Target="{Binding ElementName=Employees}" Padding="0,0,0,5"/>
                            <ComboBox x:Name="Employees" DisplayMemberPath="Name" SelectionChanged="EmployeeChanged"/>
                            <TextBlock x:Name="EmployeesEmpty" Text="No hay estilistas disponibles para registrar."
                                       Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <StackPanel x:Name="FingerFields" Visibility="Collapsed" Margin="0,10,0,0">
                                <Label Content="Dedo" Target="{Binding ElementName=Fingers}" Padding="0,0,0,5"/>
                                <ComboBox x:Name="Fingers" DisplayMemberPath="Label" SelectionChanged="FingerChanged"/>
                                <TextBlock x:Name="EnrollmentInventory" Style="{StaticResource Caption}" Margin="0,7,0,0"/>
                                <Button x:Name="EnrollButton" Content="Iniciar captura" Style="{StaticResource Primary}"
                                        HorizontalAlignment="Left" Click="Enroll" IsEnabled="False" Margin="0,12,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border x:Name="StatusBar" Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#FCFBF9">
            <WrapPanel Margin="34,0" MaxWidth="1080" MinHeight="48">
                <StackPanel Orientation="Horizontal" Margin="0,12,24,12">
                    <Ellipse x:Name="ReaderDot" Width="7" Height="7" Fill="#918D83" Margin="0,0,8,0"/>
                    <TextBlock Text="SecuGen U20" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ReaderText" Text="Comprobando…" Foreground="{StaticResource Muted}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,21,12">
                    <Ellipse Width="7" Height="7" Fill="#918D83" Margin="0,0,8,0"/>
                    <TextBlock Text="UProApp" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="Sin integración" Foreground="{StaticResource Muted}"/>
                </StackPanel>
                <TextBlock x:Name="LabBadge" Text="Pruebas · datos de ejemplo en memoria"
                           Foreground="#6B5026" VerticalAlignment="Center" Margin="0,4,0,4" Visibility="Collapsed"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
