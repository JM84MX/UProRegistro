<UserControl x:Class="UProAttendance.Presentation.AttendanceConfirmation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:UProAttendance.Presentation"
             Focusable="False">
    <UserControl.Resources>
        <SolidColorBrush x:Key="EntryBackground" Color="#FCFBF9"/>
        <SolidColorBrush x:Key="EntryBorder" Color="#EAE5DD"/>
        <SolidColorBrush x:Key="ExitBackground" Color="#F8F4ED"/>
        <SolidColorBrush x:Key="ExitBorder" Color="#EAE0D1"/>
    </UserControl.Resources>

    <Border x:Name="Surface" CornerRadius="24" BorderThickness="1" Padding="32,34,32,32"
            HorizontalAlignment="Stretch" Background="{StaticResource EntryBackground}"
            BorderBrush="{StaticResource EntryBorder}">
        <StackPanel>
            <Viewbox x:Name="Symbol" Width="112" Height="112" HorizontalAlignment="Center"
                     Margin="0,0,0,16" IsHitTestVisible="False">
                <Grid Width="112" Height="112">
                    <Grid x:Name="EntrySymbol">
                        <Ellipse Width="94" Height="94" Fill="#F3F0EA" Stroke="#E4DDD1"/>
                        <ui:FingerprintArt Width="62" Height="62" Progress="1"/>
                    </Grid>
                    <Grid x:Name="ExitSymbol" Visibility="Collapsed">
                        <Ellipse Width="94" Height="94" Fill="#F3EDE2" Stroke="#E4D9C8"/>
                        <Path Stroke="#716353" StrokeThickness="1.7" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M 34,61 C 38,50 46,45 56,45 C 66,45 74,50 78,61 M 30,64 L 82,64 M 40,71 L 72,71"/>
                        <Path Stroke="#9D8A72" StrokeThickness="1.4" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Data="M 56,39 L 56,34"/>
                    </Grid>
                    <Border Width="27" Height="27" CornerRadius="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,6,8" Background="#E7EEE6" BorderThickness="2" BorderBrush="#FCFBF9">
                        <Path Width="12" Height="9" Stretch="Uniform" Data="M 1,5 L 4,8 L 10,2" Stroke="#346448"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Border>
                </Grid>
            </Viewbox>

            <TextBlock x:Name="Receipt" FontSize="16" FontWeight="SemiBold" Foreground="#346448"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
            <TextBlock x:Name="Salutation" FontFamily="Georgia" FontSize="38" LineHeight="48" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="#25201B" MaxWidth="850"
                       AutomationProperties.HeadingLevel="Level1" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="Message" FontSize="27" FontWeight="Light" LineHeight="38" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="#423B34" MaxWidth="850" Margin="0,10,0,0"
                       AutomationProperties.LiveSetting="Polite"/>
            <TextBlock x:Name="Closing" FontFamily="Georgia" FontStyle="Italic" FontSize="16" LineHeight="23"
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#716353" MaxWidth="850" Margin="0,20,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
