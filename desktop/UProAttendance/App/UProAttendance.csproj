<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Increase the fourth version component and update the summary for each development delivery. -->
    <Version>1.0.0.4</Version>
    <DevelopmentChangeSummary>Acceso administrativo y confirmaciones breves</DevelopmentChangeSummary>
    <ShowDevelopmentBuildStamp Condition="'$(ShowDevelopmentBuildStamp)' == ''">true</ShowDevelopmentBuildStamp>
  </PropertyGroup>
  <ItemGroup Condition="'$(ShowDevelopmentBuildStamp)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DevelopmentBuildUtc</_Parameter1>
      <_Parameter2>$([System.DateTime]::UtcNow.ToString('O'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DevelopmentChangeSummary</_Parameter1>
      <_Parameter2>$(DevelopmentChangeSummary)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UProAttendance.Tests" />
    <ProjectReference Include="../Core/UProAttendance.Core.csproj" />
    <Resource Include="Assets/logo.png" />
  </ItemGroup>
</Project>
